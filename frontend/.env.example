# Used when running the web app outside Docker (`npm run dev`).
# Copy to frontend/.env.local and adjust.

# Base URL of the FastAPI backend. Read on the server only; never exposed to the browser.
API_URL=http://localhost:8000

# Optional shared secret (must match the API's CLIENT_IP_SECRET). Signs the browser IP sent to
# the API for per-client rate limiting. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CLIENT_IP_SECRET=

# Set to true only when a trusted edge overwrites X-Real-IP / X-Forwarded-For. Vercel is detected
# automatically; leave false for a directly reachable Next.js server so clients cannot choose
# their own rate-limit bucket.
CLIENT_IP_TRUST_PROXY=false
