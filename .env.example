# Copy to `.env` to override the defaults used by docker-compose.yml.
# Every value below has a working default, so `docker compose up` runs without a .env file.

# --- PostgreSQL ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

# --- API (FastAPI) ---
# Generate a strong secret for any shared or deployed environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=local-dev-secret-change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Load demo users, sprints and tasks on API startup (skipped if users already exist).
SEED_DEMO_DATA=true
# Optional shared secret for signed client-IP assertions from the web app (both services).
CLIENT_IP_SECRET=
# Web only. Set true only behind a trusted edge that overwrites client-IP headers.
CLIENT_IP_TRUST_PROXY=false
# Use redis://host:6379/0 when running multiple API processes; memory:// is per-process.
RATE_LIMIT_STORAGE_URI=memory://
