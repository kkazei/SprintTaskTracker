# Used when running the API outside Docker (`uv run uvicorn app.main:app --reload`).
# Copy to backend/.env and adjust.

DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker
JWT_SECRET_KEY=local-dev-secret-change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Shared with the web app's CLIENT_IP_SECRET. Leave empty locally to key limits by peer address.
CLIENT_IP_SECRET=
# Use redis://host:6379/0 when running multiple workers/instances; memory:// is per-process.
RATE_LIMIT_STORAGE_URI=memory://
